{
  "name": "voice-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "A voice-first desktop workspace for documents and code",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder --mac dir",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs && npm run build && electron electron/smoke.cjs && electron electron/speech-smoke.cjs"
  },
  "dependencies": {
    "@elevenlabs/react": "^0.14.0",
    "@elevenlabs/elevenlabs-js": "^2.0.0",
    "@google/genai": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.voiceworkspace.desktop",
    "productName": "Broken Handyman",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Broken Handyman uses your microphone to dictate and revise your documents."
      }
    }
  }
}
